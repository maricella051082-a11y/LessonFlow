rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isTeacher() {
      return signedIn()
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role == "teacher";
    }

    function isOwnUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isTeacherOfStudentDoc(studentDocId) {
      return isTeacher()
        && studentDocId is string
        && exists(/databases/$(database)/documents/students/$(studentDocId))
        && get(/databases/$(database)/documents/students/$(studentDocId)).data.teacherUid == request.auth.uid
        && (!('status' in get(/databases/$(database)/documents/students/$(studentDocId)).data)
          || get(/databases/$(database)/documents/students/$(studentDocId)).data.status != "archived");
    }

    function studentIdentityMatches(studentDocId, studentUid) {
      return studentDocId is string
        && exists(/databases/$(database)/documents/students/$(studentDocId))
        && "authUid" in get(/databases/$(database)/documents/students/$(studentDocId)).data
        && get(/databases/$(database)/documents/students/$(studentDocId)).data.authUid is string
        && get(/databases/$(database)/documents/students/$(studentDocId)).data.authUid == studentUid;
    }

    function isTeacherOfStudentIdentity(studentDocId, studentUid) {
      return isTeacherOfStudentDoc(studentDocId)
        && studentIdentityMatches(studentDocId, studentUid);
    }

    function isTeacherOfScheduledStudent(studentDocId, studentUid) {
      return isTeacherOfStudentDoc(studentDocId)
        && (
          (
            "authUid" in get(/databases/$(database)/documents/students/$(studentDocId)).data
            && get(/databases/$(database)/documents/students/$(studentDocId)).data.authUid is string
            && get(/databases/$(database)/documents/students/$(studentDocId)).data.authUid == studentUid
          )
          || (
            (!("authUid" in get(/databases/$(database)/documents/students/$(studentDocId)).data)
              || get(/databases/$(database)/documents/students/$(studentDocId)).data.authUid == null)
            && studentUid == ""
          )
        );
    }

    function hasOwnVocabularyAssignment(studentUid) {
      return signedIn()
        && request.auth.uid == studentUid
        && exists(
          /databases/$(database)/documents/studentVocabulary/$(studentUid)
        )
        && get(
          /databases/$(database)/documents/studentVocabulary/$(studentUid)
        ).data.studentUid == studentUid;
    }

    function assignedVocabularyProgramMatches(studentUid, vocabProgramId) {
      return hasOwnVocabularyAssignment(studentUid)
        && (
          (
            "vocabularyProgramId" in get(
              /databases/$(database)/documents/studentVocabulary/$(studentUid)
            ).data
            && get(
              /databases/$(database)/documents/studentVocabulary/$(studentUid)
            ).data.vocabularyProgramId == vocabProgramId
          )
          ||
          (
            "vocabProgramId" in get(
              /databases/$(database)/documents/studentVocabulary/$(studentUid)
            ).data
            && get(
              /databases/$(database)/documents/studentVocabulary/$(studentUid)
            ).data.vocabProgramId == vocabProgramId
          )
        );
    }

    function hasAssignedVocabularyProgram(vocabProgramId) {
      return assignedVocabularyProgramMatches(request.auth.uid, vocabProgramId);
    }


    // =========================================================
    // USERS
    // =========================================================
    match /users/{uid} {

      allow read: if isOwnUser(uid)
                  || (
                    isTeacher()
                    && resource.data.role == "student"
                    && resource.data.teacherUid == request.auth.uid
                  );

      allow create: if isTeacher()
                    && request.resource.data.role == "student"
                    && request.resource.data.teacherUid == request.auth.uid
                    && request.resource.data.studentDocId is string
                    && exists(/databases/$(database)/documents/students/$(request.resource.data.studentDocId))
                    && get(/databases/$(database)/documents/students/$(request.resource.data.studentDocId)).data.teacherUid == request.auth.uid
                    && getAfter(/databases/$(database)/documents/students/$(request.resource.data.studentDocId)).data.authUid == uid
                    && request.resource.data.keys().hasOnly([
                      "role", "name", "email", "studentDocId",
                      "teacherUid", "createdAt"
                    ]);

      allow update, delete: if false;
    }


    // =========================================================
    // CURRENT LESSONS
    // =========================================================
    match /currentLessons/{studentUid} {

      allow read: if (
                    isTeacher()
                    && resource.data.teacherUid == request.auth.uid
                  )
                  || (
                    signedIn()
                    && request.auth.uid == studentUid
                  );

      allow create: if isTeacherOfStudentIdentity(request.resource.data.studentDocId, studentUid)
                    && request.resource.data.studentUid == studentUid
                    && request.resource.data.teacherUid == request.auth.uid;

      allow update: if isTeacher()
                    && resource.data.teacherUid == request.auth.uid
                    && request.resource.data.teacherUid == resource.data.teacherUid
                    && (
                      !request.resource.data.diff(resource.data).affectedKeys().hasAny(["studentUid", "studentDocId"])
                      || (
                        request.resource.data.studentUid == studentUid
                        && isTeacherOfStudentIdentity(request.resource.data.studentDocId, studentUid)
                      )
                    );

      allow delete: if isTeacher()
                    && resource.data.teacherUid == request.auth.uid;


      match /progress/{progressId} {

        allow read: if (
                      isTeacher()
                      && get(/databases/$(database)/documents/currentLessons/$(studentUid)).data.teacherUid == request.auth.uid
                    )
                    || (
                      signedIn()
                      && request.auth.uid == studentUid
                    );

        allow create, update: if (
                                isTeacher()
                                && get(/databases/$(database)/documents/currentLessons/$(studentUid)).data.teacherUid == request.auth.uid
                              )
                              || (
                                signedIn()
                                && request.auth.uid == studentUid
                              );

        allow delete: if isTeacher()
                      && get(/databases/$(database)/documents/currentLessons/$(studentUid)).data.teacherUid == request.auth.uid;
      }
    }


    // =========================================================
    // STUDENTS
    // =========================================================
    match /students/{studentDocId} {

      allow read: if (
                    isTeacher()
                    && resource.data.teacherUid == request.auth.uid
                  )
                  || (
                    signedIn()
                    && resource.data.authUid == request.auth.uid
                  );

      allow create: if isTeacher()
                    && request.resource.data.teacherUid == request.auth.uid;

      allow update: if isTeacher()
                    && resource.data.teacherUid == request.auth.uid
                    && request.resource.data.teacherUid == request.auth.uid
                    && (
                      !request.resource.data.diff(resource.data).affectedKeys().hasAny(["authUid"])
                      || (
                        (!("authUid" in resource.data) || resource.data.authUid == null)
                        && request.resource.data.authUid is string
                        && getAfter(/databases/$(database)/documents/users/$(request.resource.data.authUid)).data.role == "student"
                        && getAfter(/databases/$(database)/documents/users/$(request.resource.data.authUid)).data.teacherUid == request.auth.uid
                        && getAfter(/databases/$(database)/documents/users/$(request.resource.data.authUid)).data.studentDocId == studentDocId
                      )
                    );

      allow delete: if isTeacher()
                    && resource.data.teacherUid == request.auth.uid;
    }


    // =========================================================
    // LESSON HISTORY
    // =========================================================
    match /lessonHistory/{studentUid}/lessons/{lessonId} {

      allow read: if (
                    isTeacher()
                    && resource.data.teacherUid == request.auth.uid
                  )
                  || (
                    signedIn()
                    && request.auth.uid == studentUid
                  );

      allow create: if isTeacher()
                    && request.resource.data.studentUid == studentUid
                    && request.resource.data.teacherUid == request.auth.uid
                    && get(/databases/$(database)/documents/currentLessons/$(studentUid)).data.teacherUid == request.auth.uid;

      allow update: if false;

      allow delete: if isTeacher()
                    && resource.data.teacherUid == request.auth.uid
                    && resource.data.studentUid == studentUid;
    }


    // =========================================================
    // FOCUS ITEMS
    // =========================================================
    match /students/{studentDocId}/focusItems/{itemId} {

      allow read: if isTeacher()
                  && get(
                    /databases/$(database)/documents/students/$(studentDocId)
                  ).data.teacherUid == request.auth.uid;

      allow create: if isTeacher()
                    && get(
                      /databases/$(database)/documents/students/$(studentDocId)
                    ).data.teacherUid == request.auth.uid
                    && request.resource.data.teacherUid == request.auth.uid;

      allow update: if isTeacher()
                    && get(
                      /databases/$(database)/documents/students/$(studentDocId)
                    ).data.teacherUid == request.auth.uid
                    && resource.data.teacherUid == request.auth.uid
                    && request.resource.data.teacherUid == request.auth.uid;

      allow delete: if isTeacher()
                    && get(
                      /databases/$(database)/documents/students/$(studentDocId)
                    ).data.teacherUid == request.auth.uid
                    && resource.data.teacherUid == request.auth.uid;
    }


    // =========================================================
    // MATERIALS
    // =========================================================
    match /materials/{materialId} {

      allow read: if isTeacher()
                  && resource.data.teacherUid == request.auth.uid;

      allow create: if isTeacher()
                    && request.resource.data.teacherUid == request.auth.uid;

      allow update: if isTeacher()
                    && resource.data.teacherUid == request.auth.uid
                    && request.resource.data.teacherUid == request.auth.uid;

      allow delete: if isTeacher()
                    && resource.data.teacherUid == request.auth.uid;
    }


    // =========================================================
    // SOURCES
    // =========================================================
    match /sources/{sourceId} {

      allow read: if isTeacher()
                  && resource.data.teacherUid == request.auth.uid;

      allow create: if isTeacher()
                    && request.resource.data.teacherUid == request.auth.uid;

      allow update: if isTeacher()
                    && resource.data.teacherUid == request.auth.uid
                    && request.resource.data.teacherUid == request.auth.uid;

      allow delete: if isTeacher()
                    && resource.data.teacherUid == request.auth.uid;
    }


    // =========================================================
    // SCHEDULE EVENTS
    // =========================================================
    match /scheduleEvents/{eventId} {

      allow read: if isTeacher()
                  && resource.data.teacherUid == request.auth.uid;

      allow read: if signedIn()
                  && resource.data.studentAuthUid == request.auth.uid;

      allow create: if isTeacher()
                    && request.resource.data.teacherUid == request.auth.uid
                    && isTeacherOfScheduledStudent(
                      request.resource.data.studentDocId,
                      request.resource.data.studentAuthUid
                    );

      allow update: if isTeacher()
                    && resource.data.teacherUid == request.auth.uid
                    && request.resource.data.teacherUid == request.auth.uid
                    && (
                      isTeacherOfScheduledStudent(
                        request.resource.data.studentDocId,
                        request.resource.data.studentAuthUid
                      )
                      || (
                        request.resource.data.studentDocId == resource.data.studentDocId
                        && request.resource.data.studentAuthUid == resource.data.studentAuthUid
                        && isTeacherOfStudentDoc(resource.data.studentDocId)
                      )
                    );

      allow delete: if isTeacher()
                    && resource.data.teacherUid == request.auth.uid;
    }


    // =========================================================
    // STUDENT SCHEDULES
    // =========================================================
    match /studentSchedules/{scheduleId} {

      allow read: if isTeacher()
                  && resource.data.teacherUid == request.auth.uid;

      allow create: if isTeacher()
                    && request.resource.data.teacherUid == request.auth.uid
                    && isTeacherOfStudentDoc(request.resource.data.studentDocId);

      allow update: if isTeacher()
                    && resource.data.teacherUid == request.auth.uid
                    && request.resource.data.teacherUid == request.auth.uid
                    && request.resource.data.studentDocId == resource.data.studentDocId
                    && isTeacherOfStudentDoc(request.resource.data.studentDocId);

      allow delete: if isTeacher()
                    && resource.data.teacherUid == request.auth.uid;
    }


    // =========================================================
    // SUBMISSIONS
    // =========================================================
    match /submissions/{submissionId} {

      allow read: if signedIn()
                  && (
                    resource.data.teacherUid == request.auth.uid
                    || resource.data.studentUid == request.auth.uid
                  );

      allow create: if signedIn()
                    && (
                      (
                        request.resource.data.studentUid == request.auth.uid
                        && studentIdentityMatches(
                          request.resource.data.studentDocId,
                          request.auth.uid
                        )
                        && request.resource.data.teacherUid == get(
                          /databases/$(database)/documents/students/$(request.resource.data.studentDocId)
                        ).data.teacherUid
                        && request.resource.data.status == "submitted"
                      )
                      ||
                      (
                        isTeacher()
                        && request.resource.data.teacherUid == request.auth.uid
                        && isTeacherOfStudentIdentity(
                          request.resource.data.studentDocId,
                          request.resource.data.studentUid
                        )
                      )
                    );

      allow update: if signedIn()
                    && (
                      (
                        isTeacher()
                        && resource.data.teacherUid == request.auth.uid
                        && request.resource.data.teacherUid == request.auth.uid
                        && request.resource.data.studentUid == resource.data.studentUid
                        && request.resource.data.studentDocId == resource.data.studentDocId
                      )
                      ||
                      (
                        resource.data.studentUid == request.auth.uid
                        && request.resource.data.studentUid == request.auth.uid
                        && request.resource.data.teacherUid == resource.data.teacherUid
                        && request.resource.data.studentDocId == resource.data.studentDocId
                        && request.resource.data.status == "submitted"
                      )
                    );

      allow delete: if isTeacher()
                    && resource.data.teacherUid == request.auth.uid;
    }


    // =========================================================
    // LEARNING PROGRAMS
    // =========================================================
    match /learningPrograms/{programId} {

      allow read: if isTeacher()
                  && resource.data.teacherUid == request.auth.uid;

      allow read: if signedIn()
                  && resource.data.studentUid == request.auth.uid;

      allow create: if isTeacher()
                    && request.resource.data.teacherUid == request.auth.uid
                    && isTeacherOfScheduledStudent(
                      request.resource.data.studentDocId,
                      request.resource.data.studentUid
                    );

      allow update: if isTeacher()
                    && resource.data.teacherUid == request.auth.uid
                    && request.resource.data.teacherUid == request.auth.uid
                    && request.resource.data.studentDocId == resource.data.studentDocId
                    && request.resource.data.studentUid == resource.data.studentUid;

      allow delete: if isTeacher()
                    && resource.data.teacherUid == request.auth.uid;


      match /lessons/{planLessonId} {

        allow read, create, update, delete: if isTeacher()
          && get(
            /databases/$(database)/documents/learningPrograms/$(programId)
          ).data.teacherUid == request.auth.uid;

        allow read: if signedIn()
          && get(
            /databases/$(database)/documents/learningPrograms/$(programId)
          ).data.studentUid == request.auth.uid;
      }
    }


    // =========================================================
    // VOCABULARY PROGRAMS
    // =========================================================
    match /vocabularyPrograms/{vocabProgramId} {

      // Teacher
      allow read: if isTeacher()
                  && resource.data.teacherUid == request.auth.uid;

      allow create: if isTeacher()
                    && request.resource.data.teacherUid == request.auth.uid;

      allow update: if isTeacher()
                    && resource.data.teacherUid == request.auth.uid
                    && request.resource.data.teacherUid == request.auth.uid;

      allow delete: if isTeacher()
                    && resource.data.teacherUid == request.auth.uid;

      // Student: только назначенная ему программа
      allow read: if hasAssignedVocabularyProgram(vocabProgramId);


      // ---------------------------------------------------------
      // ACTIVE CARDS
      // ---------------------------------------------------------
      match /cards/{cardId} {

        allow read, create, update, delete: if isTeacher()
          && get(
            /databases/$(database)/documents/vocabularyPrograms/$(vocabProgramId)
          ).data.teacherUid == request.auth.uid;

        allow read: if hasAssignedVocabularyProgram(vocabProgramId);
      }


      // ---------------------------------------------------------
      // OPTIONAL CARDS
      // ---------------------------------------------------------
      match /optionalCards/{optionalId} {

        allow read, create, update, delete: if isTeacher()
          && get(
            /databases/$(database)/documents/vocabularyPrograms/$(vocabProgramId)
          ).data.teacherUid == request.auth.uid;

        allow read: if hasAssignedVocabularyProgram(vocabProgramId);
      }


      // ---------------------------------------------------------
      // WEEKS
      // ---------------------------------------------------------
      match /weeks/{weekId} {

        allow read, create, update, delete: if isTeacher()
          && get(
            /databases/$(database)/documents/vocabularyPrograms/$(vocabProgramId)
          ).data.teacherUid == request.auth.uid;

        allow read: if hasAssignedVocabularyProgram(vocabProgramId);
      }


      // ---------------------------------------------------------
      // DAILY PLAN
      // ---------------------------------------------------------
      match /dailyPlan/{dayId} {

        allow read, create, update, delete: if isTeacher()
          && get(
            /databases/$(database)/documents/vocabularyPrograms/$(vocabProgramId)
          ).data.teacherUid == request.auth.uid;

        allow read: if hasAssignedVocabularyProgram(vocabProgramId);
      }
    }


    // =========================================================
    // STUDENT VOCABULARY
    // =========================================================
    match /studentVocabulary/{studentUid} {

      // ---------------- TEACHER ----------------

      allow read: if isTeacher()
                  && resource.data.teacherUid == request.auth.uid;

      allow create: if isTeacher()
                    && request.resource.data.teacherUid == request.auth.uid
                    && request.resource.data.studentUid == studentUid
                    && isTeacherOfStudentIdentity(
                      request.resource.data.studentDocId,
                      studentUid
                    );

      allow update: if isTeacher()
                    && resource.data.teacherUid == request.auth.uid
                    && request.resource.data.teacherUid == request.auth.uid
                    && resource.data.studentUid == studentUid
                    && request.resource.data.studentUid == studentUid
                    && request.resource.data.studentDocId == resource.data.studentDocId;

      allow delete: if isTeacher()
                    && resource.data.teacherUid == request.auth.uid
                    && resource.data.studentUid == studentUid;


      // ---------------- STUDENT READ ----------------
      // Это разрешение сейчас критично для STEP A.

      allow read: if signedIn()
                  && request.auth.uid == studentUid
                  && resource.data.studentUid == request.auth.uid;


      // ---------------- STUDENT SESSION UPDATE ----------------

      allow update: if signedIn()
                    && request.auth.uid == studentUid
                    && resource.data.studentUid == request.auth.uid
                    && request.resource.data.studentUid == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                      "currentDayIndex",
                      "currentWeekNumber",
                      "lastSessionDate",
                      "lastSessionAt",
                      "lastCompletedDayIndex",
                      "lastCompletedStudyDayIndex",
                      "lastCompletedAt",
                      "lastSessionSummary",
                      "newCount",
                      "learningCount",
                      "reviewCount",
                      "masteredCount",
                      "updatedAt"
                    ]);


      // =======================================================
      // PERSONAL CARD STATE
      // =======================================================
      match /cards/{cardId} {

        // Teacher
        allow read, create, update, delete: if isTeacher()
          && get(
            /databases/$(database)/documents/studentVocabulary/$(studentUid)
          ).data.teacherUid == request.auth.uid;


        // Student read
        allow read: if signedIn()
                    && request.auth.uid == studentUid;


        // Lazy state creation
        allow create: if signedIn()
                      && request.auth.uid == studentUid
                      && request.resource.data.cardId == cardId
                      && "vocabularyProgramId" in request.resource.data
                      && assignedVocabularyProgramMatches(
                        studentUid,
                        request.resource.data.vocabularyProgramId
                      );


        // Student updates own card state
        allow update: if signedIn()
                      && request.auth.uid == studentUid
                      && hasOwnVocabularyAssignment(studentUid)
                      && resource.data.cardId == cardId
                      && request.resource.data.cardId == cardId
                      && (
                        (
                          "vocabularyProgramId" in resource.data
                          && request.resource.data.vocabularyProgramId == resource.data.vocabularyProgramId
                          && assignedVocabularyProgramMatches(
                            studentUid,
                            request.resource.data.vocabularyProgramId
                          )
                        )
                        ||
                        (
                          !("vocabularyProgramId" in resource.data)
                          && !("vocabularyProgramId" in request.resource.data)
                        )
                      )
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                        "state",
                        "introducedAt",
                        "introducedDayIndex",
                        "lastReviewedAt",
                        "lastReviewDate",
                        "nextReviewAt",
                        "nextReviewDate",
                        "intervalStep",
                        "intervalDays",
                        "reviewCount",
                        "correctCount",
                        "incorrectCount",
                        "consecutiveCorrect",
                        "consecutiveIncorrect",
                        "masteryPasses",
                        "lastAnswer",
                        "lastDirection",
                        "updatedAt"
                      ]);
      }


      // =======================================================
      // VOCABULARY SESSIONS
      // =======================================================
      match /sessions/{sessionId} {

        // Teacher read only. Current engine has no teacher reset/delete flow.
        allow read: if isTeacher()
          && get(
            /databases/$(database)/documents/studentVocabulary/$(studentUid)
          ).data.teacherUid == request.auth.uid;

        // Student reads only sessions below own vocabulary document.
        allow read: if signedIn()
                    && request.auth.uid == studentUid;

        allow create: if signedIn()
                      && request.auth.uid == studentUid
                      && request.resource.data.studentUid == studentUid
                      && assignedVocabularyProgramMatches(
                        studentUid,
                        request.resource.data.programId
                      );

        allow update: if signedIn()
                      && request.auth.uid == studentUid
                      && hasOwnVocabularyAssignment(studentUid)
                      && resource.data.studentUid == studentUid
                      && request.resource.data.studentUid == studentUid
                      && request.resource.data.programId == resource.data.programId
                      && request.resource.data.date == resource.data.date
                      && request.resource.data.dayIndex == resource.data.dayIndex
                      && request.resource.data.weekNumber == resource.data.weekNumber
                      && request.resource.data.sessionType == resource.data.sessionType
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                        "status",
                        "startedAt",
                        "completedAt",
                        "answeredCards",
                        "againCount",
                        "hardCount",
                        "knowCount",
                        "answers",
                        "cardOrder",
                        "newCardIds",
                        "reviewCardIds",
                        "totalCards",
                        "summary",
                        "updatedAt"
                      ]);
      }
    }


    // =========================================================
    // PRIVATE TEACHER / STUDENT CONVERSATIONS
    // =========================================================
    match /conversations/{conversationId} {

      function validStudentRelationship(data) {
        return "studentDocId" in data
          && exists(/databases/$(database)/documents/students/$(data.studentDocId))
          && get(/databases/$(database)/documents/students/$(data.studentDocId)).data.teacherUid == data.teacherUid
          && get(/databases/$(database)/documents/students/$(data.studentDocId)).data.authUid == data.studentUid;
      }

      function isConversationParticipant(data) {
        return signedIn()
          && (request.auth.uid == data.teacherUid || request.auth.uid == data.studentUid);
      }

      function immutableParticipants() {
        return request.resource.data.teacherUid == resource.data.teacherUid
          && request.resource.data.studentUid == resource.data.studentUid
          && request.resource.data.studentDocId == resource.data.studentDocId
          && request.resource.data.createdAt == resource.data.createdAt;
      }

      function validTeacherMetadataUpdate() {
        return request.auth.uid == resource.data.teacherUid
          && (
            (
              request.resource.data.unreadTeacher == 0
              && request.resource.data.unreadStudent == resource.data.unreadStudent
              && request.resource.data.lastMessageText == resource.data.lastMessageText
              && request.resource.data.lastMessageAt == resource.data.lastMessageAt
              && request.resource.data.lastMessageSenderUid == resource.data.lastMessageSenderUid
              && request.resource.data.teacherLastReadAt == request.time
              && request.resource.data.studentLastReadAt == resource.data.studentLastReadAt
              && request.resource.data.updatedAt == resource.data.updatedAt
            )
            ||
            (
              request.resource.data.unreadTeacher == resource.data.unreadTeacher
              && request.resource.data.unreadStudent == resource.data.unreadStudent + 1
              && request.resource.data.lastMessageSenderUid == request.auth.uid
              && request.resource.data.lastMessageAt == request.time
              && request.resource.data.updatedAt == request.time
              && request.resource.data.lastMessageText is string
              && request.resource.data.lastMessageText.size() > 0
              && request.resource.data.lastMessageText.size() <= 2000
              && request.resource.data.teacherLastReadAt == resource.data.teacherLastReadAt
              && request.resource.data.studentLastReadAt == resource.data.studentLastReadAt
            )
          );
      }

      function validStudentMetadataUpdate() {
        return request.auth.uid == resource.data.studentUid
          && (
            (
              request.resource.data.unreadStudent == 0
              && request.resource.data.unreadTeacher == resource.data.unreadTeacher
              && request.resource.data.lastMessageText == resource.data.lastMessageText
              && request.resource.data.lastMessageAt == resource.data.lastMessageAt
              && request.resource.data.lastMessageSenderUid == resource.data.lastMessageSenderUid
              && request.resource.data.studentLastReadAt == request.time
              && request.resource.data.teacherLastReadAt == resource.data.teacherLastReadAt
              && request.resource.data.updatedAt == resource.data.updatedAt
            )
            ||
            (
              request.resource.data.unreadStudent == resource.data.unreadStudent
              && request.resource.data.unreadTeacher == resource.data.unreadTeacher + 1
              && request.resource.data.lastMessageSenderUid == request.auth.uid
              && request.resource.data.lastMessageAt == request.time
              && request.resource.data.updatedAt == request.time
              && request.resource.data.lastMessageText is string
              && request.resource.data.lastMessageText.size() > 0
              && request.resource.data.lastMessageText.size() <= 2000
              && request.resource.data.teacherLastReadAt == resource.data.teacherLastReadAt
              && request.resource.data.studentLastReadAt == resource.data.studentLastReadAt
            )
          );
      }

      allow get: if isConversationParticipant(resource.data)
                 && validStudentRelationship(resource.data);

      // Collection queries must be constrained to the authenticated
      // participant. The full student relationship remains enforced on
      // document reads and every conversation/message write.
      allow list: if signedIn()
                  && (
                    resource.data.teacherUid == request.auth.uid
                    || resource.data.studentUid == request.auth.uid
                  );

      allow create: if isConversationParticipant(request.resource.data)
                    && validStudentRelationship(request.resource.data)
                    && conversationId == request.resource.data.teacherUid + "__" + request.resource.data.studentUid
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.unreadTeacher == 0
                    && request.resource.data.unreadStudent == 0
                    && request.resource.data.keys().hasOnly([
                      "teacherUid", "studentUid", "studentDocId",
                      "createdAt", "updatedAt", "lastMessageText",
                      "lastMessageAt", "lastMessageSenderUid",
                      "unreadTeacher", "unreadStudent",
                      "teacherLastReadAt", "studentLastReadAt"
                    ]);

      allow update: if isConversationParticipant(resource.data)
                    && validStudentRelationship(resource.data)
                    && immutableParticipants()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                      "updatedAt", "lastMessageText", "lastMessageAt",
                      "lastMessageSenderUid", "unreadTeacher", "unreadStudent",
                      "teacherLastReadAt", "studentLastReadAt"
                    ])
                    && (validTeacherMetadataUpdate() || validStudentMetadataUpdate());

      allow delete: if false;

      match /messages/{messageId} {
        function parentConversation() {
          return get(/databases/$(database)/documents/conversations/$(conversationId)).data;
        }

        function parentConversationAfter() {
          return getAfter(/databases/$(database)/documents/conversations/$(conversationId)).data;
        }

        allow read: if isConversationParticipant(parentConversation())
                    && validStudentRelationship(parentConversation());

        allow create: if isConversationParticipant(parentConversation())
                      && validStudentRelationship(parentConversation())
                      && request.resource.data.senderUid == request.auth.uid
                      && request.resource.data.type == "text"
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 2000
                      && request.resource.data.createdAt == request.time
                      && parentConversationAfter().lastMessageText == request.resource.data.text
                      && parentConversationAfter().lastMessageAt == request.time
                      && parentConversationAfter().lastMessageSenderUid == request.auth.uid
                      && parentConversationAfter().updatedAt == request.time
                      && request.resource.data.keys().hasOnly([
                        "senderUid", "text", "type", "createdAt"
                      ]);

        allow update, delete: if false;
      }
    }


    // =========================================================
    // EVERYTHING ELSE CLOSED
    // =========================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
